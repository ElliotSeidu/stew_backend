# STEW Backend — Environment Variable Template
# Copy this file to .env and fill in the values. NEVER commit .env to git.

# ----------------------------------------------------------------------------
# Django Core
# ----------------------------------------------------------------------------
# APP_ENV: 'production' (default), 'staging', or 'development'
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_64

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames, e.g. stew.knust.edu.gh,api.stew.knust.edu.gh
ALLOWED_HOSTS=localhost,127.0.0.1

# Number of trusted reverse proxies appending to X-Forwarded-For (0 = REMOTE_ADDR only)
TRUSTED_PROXY_COUNT=0

# Global DRF throttle ceilings (requests per minute)
THROTTLE_ANON_PER_MIN=1000
THROTTLE_USER_PER_MIN=120

# ----------------------------------------------------------------------------
# CORS — Comma-separated list of allowed frontend origins
# e.g. https://stew.knust.edu.gh,https://www.stew.knust.edu.gh
# Leave empty to use the development default (http://localhost:5173)
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# Database (production — PostgreSQL)
# Leave DB_ENGINE=sqlite3 for local development only.
# ----------------------------------------------------------------------------
DB_ENGINE=sqlite3
# DB_ENGINE=postgresql
# DB_NAME=stew
# DB_USER=stew_user
# DB_PASSWORD=CHANGE_ME_strong_random_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require

# ----------------------------------------------------------------------------
# Paystack Payment Gateway & JWT Session Config
# ----------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_ALLOW_MOCK=False
JWT_ACCESS_TOKEN_LIFETIME_HOURS=12
UNPAID_ORDER_TTL_MINUTES=30
FAILED_LOGIN_RETENTION_DAYS=30
FAILED_LOGIN_IP_HOURLY_CAP=60
CUSTOMER_CANCEL_UNTIL_PREP_STARTS=True
CUSTOMER_CANCEL_WINDOW_SECONDS=120
CUSTOMER_PAID_CANCELS_PER_DAY=5
# Staging only (forbidden in production): comma-separated exact lowercase emails
BETA_EMAIL_ALLOWLIST=
