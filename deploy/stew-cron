# /etc/cron.d/stew — scheduled STEW maintenance tasks
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

*/10 * * * * stew set -a && . /etc/stew/stew.env && set +a && /opt/stew/stew_backend/venv/bin/python /opt/stew/stew_backend/manage.py expire_unpaid_orders >> /var/log/stew/cron.log 2>&1
*/15 * * * * stew set -a && . /etc/stew/stew.env && set +a && /opt/stew/stew_backend/venv/bin/python /opt/stew/stew_backend/manage.py retry_pending_refunds >> /var/log/stew/cron.log 2>&1
15 3 * * * stew set -a && . /etc/stew/stew.env && set +a && /opt/stew/stew_backend/venv/bin/python /opt/stew/stew_backend/manage.py cleanup_rate_limits --batch-size 1000 --margin-seconds 3600 >> /var/log/stew/cron.log 2>&1
